# Railway Deployment Environment Variables Template

# System Details
PROJECT_NAME="Flood Rescue Data Management & Dynamic Reporting System"
VERSION="1.0.0"
API_V1_STR="/api"

# JWT Authentication Security (Change this in production!)
SECRET_KEY="FLOOD_RESCUE_SUPER_SECRET_JWT_KEY_2026_RAILWAY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Automatically provided by Railway when you reference ${{ Postgres.DATABASE_URL }})
DATABASE_URL="${{ Postgres.DATABASE_URL }}"

# CORS Origins (Comma-separated allowed domains, or * for all)
CORS_ORIGINS="*"

# OTP Passcode Expiration (Minutes)
OTP_EXPIRE_MINUTES=5

# Railway Admin & Contact
ADMIN_EMAIL="balajisara100@gmail.com"

# Brevo / Gmail SMTP Email Configuration (For Email OTP Passcodes)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER="your-brevo-smtp-login"
SMTP_PASSWORD="your-smtp-key"
MAIL_FROM="your-verified-email"
DEFAULT_FROM_EMAIL="your-verified-email"
